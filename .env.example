# ==============================================================================
# SAHAYAK (MoSJE) - Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment
# ==============================================================================

# Backend Express API Server Port
PORT=5000

# Frontend Vite API Base URL (used in production builds or custom reverse proxies)
VITE_API_URL=http://localhost:5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# Optional Integrations & Sandbox Keys (Simulated fallbacks exist if left empty)
# ------------------------------------------------------------------------------

# Gemini / LLM API Key (Optional for cloud AI chat responses; fallback to local grounded NLU)
GEMINI_API_KEY=

# DigiLocker Sandbox API Credentials (Optional; mock sandbox used if unconfigured)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# MyScheme Public API Key (For scheme metadata synchronization scripts)
MYSCHEME_API_KEY=
